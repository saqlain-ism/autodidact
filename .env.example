# Copy this file to .env and paste your keys after the = signs.
# .env is ignored by git, so your keys never reach GitHub.

# Free key: https://aistudio.google.com  ("Get API key")
GEMINI_API_KEY=

# Free key: https://console.groq.com  ("API Keys")
GROQ_API_KEY=

# Which provider runs experiments by default: gemini or groq
AUTODIDACT_PROVIDER=gemini

# ---- Optional tuning (the defaults are fine to start with) ----

# Models. Check what your free tier allows at https://aistudio.google.com/rate-limit
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b

# Requests per minute to stay under your free-tier limit.
# GEMINI_RPM=10
# GROQ_RPM=20

# How much the model "thinks" before answering: none, low, medium, high
# GEMINI_REASONING_EFFORT=low
# GROQ_REASONING_EFFORT=low
